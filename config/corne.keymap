#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        // Require the key to be held before powering the keyboard down. Soft
        // off can only be undone with the physical RESET button on both halves,
        // so a tap must never be enough to trigger it.
        //
        // &soft_off itself is already provided by behaviors.dtsi (including
        // split-peripheral-off-on-press); this is a separate, safer instance.
        //
        // NOTE: hold-time-ms is only honoured on the CENTRAL half — on a
        // peripheral, split-peripheral-off-on-press powers down immediately on
        // press and skips the hold check. On a Corne the LEFT half is central
        // (see the shield's Kconfig.defconfig), which is why this is bound on
        // the left. Moving it to the right half would make it a hair trigger.
        hold_soft_off: hold_soft_off {
            compatible = "zmk,behavior-soft-off";
            #binding-cells = <0>;
            split-peripheral-off-on-press;
            hold-time-ms = <2000>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y    &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                         &kp LGUI  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp RALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB     &kp N1        &kp N2        &kp N3           &kp N4        &kp N5          &kp N6    &kp N7    &kp N8    &kp N9     &kp N0  &kp BSPC
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2     &bt BT_SEL 3  &bt BT_SEL 4    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &trans  &trans
&kp LSHFT   &out OUT_TOG  &bl BL_TOG    &rgb_ug RGB_TOG  &trans        &mo 3           &trans    &trans    &trans    &trans     &trans  &trans
                                        &kp LGUI         &trans        &kp SPACE       &kp RET   &trans    &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp EXCL   &kp AT  &kp HASH           &kp DLLR       &kp PRCNT           &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &kp QMARK  &trans  &kp DOUBLE_QUOTES  &kp SEMI       &kp COLON           &kp EQUAL  &kp MINUS  &kp LBKT         &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans     &trans  &kp SINGLE_QUOTE   &kp LESS_THAN  &kp GREATER_THAN    &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp PIPE  &kp TILDE
                              &kp LGUI           &trans         &kp SPACE           &kp RET    &trans     &kp RALT
            >;
        };

        layer_3 {
            // -----------------------------------------------------------------------------------------
            // |  F1  |  F2 |  F3 |  F4 |  F5 |  F6 |   |  F7  |  F8 |  F9 | F10 | F11 | F12  |
            // | EXTPW|     |     |     |     |     |   | PSCRN|     | BRI+| MUTE| VOL-| VOL+ |
            // | SOFF |     |     |     |     |     |   |      |     | BRI-| PREV| PLAY| NEXT |
            //                    |     |     |     |   |      |     |     |
            //
            // Power controls live here, two layers deep (LWR -> L3), on the
            // outer edge of the left half:
            //   EXTPW = &ext_power EP_TOG — cut/restore VCC to the LED strip.
            //   SOFF  = &hold_soft_off    — hold 2s to power the keyboard off.
            //                               Wake it with the RESET button on
            //                               BOTH halves.

            bindings = <
&kp F1               &kp F2  &kp F3  &kp F4  &kp F5  &kp F6    &kp F7           &kp F8  &kp F9                &kp F10         &kp F11           &kp F12
&ext_power EP_TOG    &trans  &trans  &trans  &trans  &trans    &kp PRINTSCREEN  &trans  &kp C_BRIGHTNESS_INC  &kp C_MUTE      &kp C_VOL_DN      &kp C_VOLUME_UP
&hold_soft_off       &trans  &trans  &trans  &trans  &trans    &trans           &trans  &kp C_BRIGHTNESS_DEC  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT
                                     &trans  &trans  &trans    &trans           &trans  &trans
            >;
        };
    };
};
